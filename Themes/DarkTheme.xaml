<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Темна тема: Глибока графітова палітра -->
    <Color x:Key="BgSurfaceColor">#121214</Color>
    <Color x:Key="CardSurfaceColor">#1A1A1E</Color>
    <Color x:Key="CardBorderColor">#2A2A30</Color>
    <Color x:Key="TextPrimaryColor">#EDEDED</Color>
    <Color x:Key="TextMutedColor">#8A8A93</Color>
    <Color x:Key="HoverBgColor">#26262B</Color>
    <Color x:Key="InputBgColor">#141417</Color>
    <Color x:Key="InputBorderColor">#2E2E36</Color>
    <Color x:Key="InputFocusBorderColor">#484854</Color>
    <Color x:Key="SeparatorColor">#26262E</Color>

    <!-- Кольори фітнес-кілець БЖВ -->
    <Color x:Key="MacroFatColor">#F59E0B</Color>
    <Color x:Key="MacroProteinColor">#3B82F6</Color>
    <Color x:Key="MacroCarbsColor">#EF4444</Color>
    <Color x:Key="MacroEmeraldColor">#10B981</Color>

    <!-- Пензлі темної теми -->
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource BgSurfaceColor}" />
    <SolidColorBrush x:Key="CardSurfaceBrush" Color="{StaticResource CardSurfaceColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="HoverBgBrush" Color="{StaticResource HoverBgColor}" />
    <SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource InputBgColor}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}" />
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="{StaticResource InputFocusBorderColor}" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="{StaticResource SeparatorColor}" />

    <SolidColorBrush x:Key="MacroFatBrush" Color="{StaticResource MacroFatColor}" />
    <SolidColorBrush x:Key="MacroProteinBrush" Color="{StaticResource MacroProteinColor}" />
    <SolidColorBrush x:Key="MacroCarbsBrush" Color="{StaticResource MacroCarbsColor}" />
    <SolidColorBrush x:Key="MacroEmeraldBrush" Color="{StaticResource MacroEmeraldColor}" />

    <!-- Напівпрозорі темні доріжки кілець (rgba(255, 255, 255, 0.08)) -->
    <SolidColorBrush x:Key="RingTrackBrush" Color="#FFFFFF" Opacity="0.08" />
    <SolidColorBrush x:Key="MacroFatTrackBrush" Color="{StaticResource MacroFatColor}" Opacity="0.16" />
    <SolidColorBrush x:Key="MacroProteinTrackBrush" Color="{StaticResource MacroProteinColor}" Opacity="0.16" />
    <SolidColorBrush x:Key="MacroCarbsTrackBrush" Color="{StaticResource MacroCarbsColor}" Opacity="0.16" />

    <!-- Стилі аватарок карток каталогу (темна тема: графітовий фон з тонкою рамкою) -->
    <SolidColorBrush x:Key="ProductAvatarBgBrush" Color="#222228" />
    <SolidColorBrush x:Key="ProductAvatarBorderBrush" Color="#2E2E38" />

    <!-- Акрилове скло (Glassmorphism / Fluted Glass) -->
    <SolidColorBrush x:Key="WindowGlassBgBrush" Color="#30151518" />
    <SolidColorBrush x:Key="WindowGlassBorderBrush" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="FrostedCardBgBrush" Color="#D91E1E24" />
    <SolidColorBrush x:Key="FrostedCardBorderBrush" Color="#30FFFFFF" />

    <!-- Ребристий шейдер Fluted Glass (вертикальні призми 16px з відблисками та тінями) -->
    <LinearGradientBrush x:Key="FlutedGlassRibsBrush" StartPoint="0,0" EndPoint="1,0" SpreadMethod="Repeat" MappingMode="Absolute">
        <LinearGradientBrush.Transform>
            <ScaleTransform ScaleX="16" />
        </LinearGradientBrush.Transform>
        <!-- Напівпрозорий відблиск (Highlight) -->
        <GradientStop Color="#35FFFFFF" Offset="0.0" />
        <GradientStop Color="#00FFFFFF" Offset="0.3" />
        <!-- Повністю прозора середина (видно робочий стіл) -->
        <GradientStop Color="#00000000" Offset="0.7" />
        <!-- М'яка напівпрозора тінь ребра (Shadow) -->
        <GradientStop Color="#35000000" Offset="1.0" />
    </LinearGradientBrush>
</ResourceDictionary>
