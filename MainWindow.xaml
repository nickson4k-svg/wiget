<Window x:Class="CalWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CalWidget"
        Width="300"
        Height="490"
        MinWidth="300"
        MinHeight="470"
        MaxWidth="740"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        RenderOptions.BitmapScalingMode="HighQuality"
        RenderOptions.ClearTypeHint="Enabled"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextFormattingMode="Display"
        MouseDown="Window_MouseDown"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Показати / Сховати" Click="TrayShowHide_Click" />
            <MenuItem Header="+ Додати продукт чи напій..." Click="OpenCatalog_Click" />
            <MenuItem Header="Змінити тему (Світла / Темна)" Click="ThemeToggle_Click" />
            <MenuItem Header="Налаштування норми (BMR / TDEE)" Click="SettingsButton_Click" />
            <MenuItem Header="Скинути сьогоднішній лічильник" Click="ResetToday_Click" />
            <Separator Background="{DynamicResource CardBorderBrush}" Margin="4,2" />
            <MenuItem Header="Закріпити поверх інших вікон" Click="PinButton_Click" />
            <MenuItem Header="Вийти з програми" Click="Exit_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <!-- Стиль для пігулок-фільтрів категорій у каталозі -->
        <Style x:Key="FlyoutCategoryPill" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource FrostedCardBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FrostedCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="pillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,4,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="{DynamicResource HoverBgBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="{DynamicResource HoverBgBrush}" />
                                <Setter TargetName="pillBorder" Property="BorderBrush" Value="{DynamicResource MacroEmeraldBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопок швидких порцій у каталозі -->
        <Style x:Key="FlyoutPortionChip" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource FrostedCardBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FrostedCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chipBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,4,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chipBorder" Property="Background" Value="{DynamicResource HoverBgBrush}" />
                                <Setter TargetName="chipBorder" Property="BorderBrush" Value="{DynamicResource MacroEmeraldBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Single root Border: CornerRadius=20, ClipToBounds=True -->
    <Border x:Name="MainContainer"
            CornerRadius="20"
            BorderBrush="{DynamicResource WindowGlassBorderBrush}"
            BorderThickness="1"
            ClipToBounds="True">
        <Border.Background>
            <ImageBrush x:Name="CascadeGlassBrush" Stretch="Fill" />
        </Border.Background>

        <Grid>
            <!-- Тонкий контур та внутрішній скляний блік по периметру -->
            <Border CornerRadius="19"
                    BorderBrush="{DynamicResource WindowGlassBorderBrush}"
                    BorderThickness="0.5"
                    IsHitTestVisible="False" />

            <!-- Шар 3: Двоколонкова сітка: Колонка 0 (Віджет 286px) | Колонка 1 (Висувний каталог) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="286" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

            <!-- ============================================================== -->
            <!-- КОЛОНКА 0: ГОЛОВНИЙ ВІДЖЕТ (ЧИСТИЙ ТА МІНІМАЛІСТИЧНИЙ)         -->
            <!-- ============================================================== -->
            <Grid Grid.Column="0" Margin="14,10,14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />  <!-- 0: Clean Header (Buttons only, no title) -->
                    <RowDefinition Height="Auto" />  <!-- 1: Concentric Rings -->
                    <RowDefinition Height="Auto" />  <!-- 2: 3-Column Macro Details with Vector Icons -->
                    <RowDefinition Height="Auto" />  <!-- 3: Smart Meal Schedule & Countdown -->
                    <RowDefinition Height="Auto" />  <!-- 4: Button "+ Додати продукт чи напій..." -->
                </Grid.RowDefinitions>

                <!-- Row 0: Чиста шапка без написів (вільна зона для DragMove зліва, кнопки справа) -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Ліва зона вільна для перетягування вікна мишею -->
                    <Rectangle Grid.Column="0" Fill="Transparent" IsHitTestVisible="False" />

                    <!-- Кнопки швидких дій праворуч -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Undo Button -->
                        <Button x:Name="UndoBtn"
                                Style="{StaticResource MinimalIconButton}"
                                Click="UndoButton_Click"
                                ToolTip="Скасувати останній запис (Undo)"
                                Padding="3"
                                Margin="0,0,2,0">
                            <Path Width="12" Height="12"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M12.5,8C9.85,8 7.45,9 5.6,10.6L2,7V16H11L7.38,12.38C8.77,11.22 10.54,10.5 12.5,10.5C16.04,10.5 19.05,12.81 20.1,16L22.47,15.22C21.08,11.03 17.15,8 12.5,8Z"
                                  Stretch="Uniform" />
                        </Button>

                        <!-- Theme Toggle Button (Sun / Moon) -->
                        <Button x:Name="ThemeToggleBtn"
                                Style="{StaticResource MinimalIconButton}"
                                Click="ThemeToggle_Click"
                                ToolTip="Перемкнути тему (Світла / Темна)"
                                Padding="3"
                                Margin="0,0,2,0">
                            <Path x:Name="ThemeIconPath" Width="12" Height="12"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M12,18C11.11,18 10.26,17.8 9.5,17.45C11.56,16.5 13,14.42 13,12C13,9.58 11.56,7.5 9.5,6.55C10.26,6.2 11.11,6 12,6A6,6 0 0,1 18,12A6,6 0 0,1 12,18M20,8.69V4H15.31L12,0.69L8.69,4H4V8.69L0.69,12L4,15.31V20H8.69L12,23.31L15.31,20H20V15.31L23.31,12L20,8.69Z"
                                  Stretch="Uniform" />
                        </Button>

                        <!-- Pin Button (TopMost) -->
                        <Button x:Name="PinBtn"
                                Style="{StaticResource MinimalIconButton}"
                                Click="PinButton_Click"
                                ToolTip="Закріпити поверх інших вікон"
                                Padding="3"
                                Margin="0,0,2,0">
                            <Path Width="12" Height="12"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M16,12V4H17V2H7V4H8V12L6,14V16H11V22H13V16H18V14L16,12Z"
                                  Stretch="Uniform" />
                        </Button>

                        <!-- Settings Button -->
                        <Button x:Name="SettingsBtn"
                                Style="{StaticResource MinimalIconButton}"
                                Click="SettingsButton_Click"
                                ToolTip="Налаштування норми (BMR / TDEE)"
                                Padding="3"
                                Margin="0,0,2,0">
                            <Path Width="12" Height="12"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                                  Stretch="Uniform" />
                        </Button>

                        <!-- Hide / Close to Tray Button (✕) -->
                        <Button x:Name="HideBtn"
                                Style="{StaticResource MinimalIconButton}"
                                Click="HideButton_Click"
                                ToolTip="Згорнути в трей"
                                Padding="3">
                            <Path Width="11" Height="11"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                  Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Liquid Glass Macro Rings -->
                <Grid Grid.Row="1" Margin="0,10,0,10" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="196" Height="196">

                        <!-- ═══════════════════════════════════════════════════════ -->
                        <!-- OUTER RING: FATS — Liquid Glass Tube (R=87, D=174)     -->
                        <!-- ═══════════════════════════════════════════════════════ -->

                        <!-- T1: Glass tube body — tinted, semi-opaque (the glass material itself) -->
                        <Ellipse Width="174" Height="174"
                                 StrokeThickness="11"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Opacity="0.45">
                            <Ellipse.Stroke>
                                <SolidColorBrush Color="#F59E0B" />
                            </Ellipse.Stroke>
                        </Ellipse>

                        <!-- T2: Primary top sheen — strong white reflection on upper arc (light source) -->
                        <Ellipse Width="174" Height="174"
                                 StrokeThickness="11"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 IsHitTestVisible="False">
                            <Ellipse.Stroke>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#D0FFFFFF" Offset="0.00" />  <!-- very bright top -->
                                    <GradientStop Color="#80FFFFFF" Offset="0.12" />
                                    <GradientStop Color="#25FFFFFF" Offset="0.35" />
                                    <GradientStop Color="#00FFFFFF" Offset="0.55" />  <!-- transparent middle -->
                                    <GradientStop Color="#15000000" Offset="0.80" />  <!-- subtle bottom shadow -->
                                    <GradientStop Color="#35000000" Offset="1.00" />  <!-- dark bottom edge -->
                                </LinearGradientBrush>
                            </Ellipse.Stroke>
                        </Ellipse>

                        <!-- T3: Inner hollow shadow — slightly thinner, darkens tube interior (depth illusion) -->
                        <Ellipse Width="174" Height="174"
                                 StrokeThickness="5"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 IsHitTestVisible="False">
                            <Ellipse.Stroke>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#00000000" Offset="0.0" />   <!-- transparent top -->
                                    <GradientStop Color="#00000000" Offset="0.45" />
                                    <GradientStop Color="#40000000" Offset="0.75" />  <!-- shadow on inside-bottom -->
                                    <GradientStop Color="#60000000" Offset="1.00" />
                                </LinearGradientBrush>
                            </Ellipse.Stroke>
                        </Ellipse>

                        <!-- T4: Secondary inner reflection — faint white glow from bottom (refraction) -->
                        <Ellipse Width="174" Height="174"
                                 StrokeThickness="2"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 IsHitTestVisible="False">
                            <Ellipse.Stroke>
                                <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                                    <GradientStop Color="#38FFFFFF" Offset="0.0" />   <!-- bottom secondary shine -->
                                    <GradientStop Color="#00FFFFFF" Offset="0.5" />
                                </LinearGradientBrush>
                            </Ellipse.Stroke>
                        </Ellipse>

                        <!-- T5: Outer bright rim — 1px glassy edge highlight -->
                        <Ellipse Width="174" Height="174"
                                 StrokeThickness="1"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 IsHitTestVisible="False">
                            <Ellipse.Stroke>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#D0FFFFFF" Offset="0.0" />
                                    <GradientStop Color="#40FFFFFF" Offset="0.5" />
                                    <GradientStop Color="#20FFFFFF" Offset="1.0" />
                                </LinearGradientBrush>
                            </Ellipse.Stroke>
                        </Ellipse>

                        <!-- Layer 2: Fluid core arc (11px, gradient amber) -->
                        <Path x:Name="RingFatsPath"
                              StrokeThickness="11"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round">
                            <Path.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FBBF24" Offset="0" />
                                    <GradientStop Color="#F59E0B" Offset="0.5" />
                                    <GradientStop Color="#D97706" Offset="1" />
                                </LinearGradientBrush>
                            </Path.Stroke>
                            <Path.Effect>
                                <DropShadowEffect Color="#F59E0B" BlurRadius="10" ShadowDepth="0" Opacity="0.55" />
                            </Path.Effect>
                        </Path>
                        <!-- Layer 3: Specular highlight (1.5px white gloss on arc edge) -->
                        <Path x:Name="RingFatsHighlightPath"
                              Stroke="#70FFFFFF"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />

                        <!-- ═══════════════════════════════════════════════════════ -->
                        <!-- MIDDLE RING: PROTEIN — Liquid Glass Tube (R=74, D=148) -->
                        <!-- ═══════════════════════════════════════════════════════ -->

                        <!-- T1: Glass tube body -->
                        <Ellipse Width="148" Height="148"
                                 StrokeThickness="11"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Opacity="0.45">
                            <Ellipse.Stroke>
                                <SolidColorBrush Color="#3B82F6" />
                            </Ellipse.Stroke>
                        </Ellipse>

                        <!-- T2: Primary top sheen -->
                        <Ellipse Width="148" Height="148"
                                 StrokeThickness="11"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 IsHitTestVisible="False">
                            <Ellipse.Stroke>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#D0FFFFFF" Offset="0.00" />
                                    <GradientStop Color="#80FFFFFF" Offset="0.12" />
                                    <GradientStop Color="#25FFFFFF" Offset="0.35" />
                                    <GradientStop Color="#00FFFFFF" Offset="0.55" />
                                    <GradientStop Color="#15000000" Offset="0.80" />
                                    <GradientStop Color="#35000000" Offset="1.00" />
                                </LinearGradientBrush>
                            </Ellipse.Stroke>
                        </Ellipse>

                        <!-- T3: Inner hollow shadow -->
                        <Ellipse Width="148" Height="148"
                                 StrokeThickness="5"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 IsHitTestVisible="False">
                            <Ellipse.Stroke>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#00000000" Offset="0.0" />
                                    <GradientStop Color="#00000000" Offset="0.45" />
                                    <GradientStop Color="#40000000" Offset="0.75" />
                                    <GradientStop Color="#60000000" Offset="1.00" />
                                </LinearGradientBrush>
                            </Ellipse.Stroke>
                        </Ellipse>

                        <!-- T4: Secondary inner reflection -->
                        <Ellipse Width="148" Height="148"
                                 StrokeThickness="2"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 IsHitTestVisible="False">
                            <Ellipse.Stroke>
                                <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                                    <GradientStop Color="#38FFFFFF" Offset="0.0" />
                                    <GradientStop Color="#00FFFFFF" Offset="0.5" />
                                </LinearGradientBrush>
                            </Ellipse.Stroke>
                        </Ellipse>

                        <!-- T5: Outer bright rim -->
                        <Ellipse Width="148" Height="148"
                                 StrokeThickness="1"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 IsHitTestVisible="False">
                            <Ellipse.Stroke>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#D0FFFFFF" Offset="0.0" />
                                    <GradientStop Color="#40FFFFFF" Offset="0.5" />
                                    <GradientStop Color="#20FFFFFF" Offset="1.0" />
                                </LinearGradientBrush>
                            </Ellipse.Stroke>
                        </Ellipse>

                        <!-- Layer 2: Fluid core arc (11px, gradient neon blue) -->
                        <Path x:Name="RingProteinPath"
                              StrokeThickness="11"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round">
                            <Path.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#38BDF8" Offset="0" />
                                    <GradientStop Color="#0284C7" Offset="0.5" />
                                    <GradientStop Color="#0369A1" Offset="1" />
                                </LinearGradientBrush>
                            </Path.Stroke>
                            <Path.Effect>
                                <DropShadowEffect Color="#3B82F6" BlurRadius="10" ShadowDepth="0" Opacity="0.55" />
                            </Path.Effect>
                        </Path>
                        <!-- Layer 3: Specular highlight -->
                        <Path x:Name="RingProteinHighlightPath"
                              Stroke="#70FFFFFF"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />

                        <!-- ═══════════════════════════════════════════════════════ -->
                        <!-- INNER RING: CARBS — Liquid Glass Tube (R=61, D=122)    -->
                        <!-- ═══════════════════════════════════════════════════════ -->

                        <!-- T1: Glass tube body -->
                        <Ellipse Width="122" Height="122"
                                 StrokeThickness="11"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Opacity="0.45">
                            <Ellipse.Stroke>
                                <SolidColorBrush Color="#EF4444" />
                            </Ellipse.Stroke>
                        </Ellipse>

                        <!-- T2: Primary top sheen -->
                        <Ellipse Width="122" Height="122"
                                 StrokeThickness="11"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 IsHitTestVisible="False">
                            <Ellipse.Stroke>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#D0FFFFFF" Offset="0.00" />
                                    <GradientStop Color="#80FFFFFF" Offset="0.12" />
                                    <GradientStop Color="#25FFFFFF" Offset="0.35" />
                                    <GradientStop Color="#00FFFFFF" Offset="0.55" />
                                    <GradientStop Color="#15000000" Offset="0.80" />
                                    <GradientStop Color="#35000000" Offset="1.00" />
                                </LinearGradientBrush>
                            </Ellipse.Stroke>
                        </Ellipse>

                        <!-- T3: Inner hollow shadow -->
                        <Ellipse Width="122" Height="122"
                                 StrokeThickness="5"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 IsHitTestVisible="False">
                            <Ellipse.Stroke>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#00000000" Offset="0.0" />
                                    <GradientStop Color="#00000000" Offset="0.45" />
                                    <GradientStop Color="#40000000" Offset="0.75" />
                                    <GradientStop Color="#60000000" Offset="1.00" />
                                </LinearGradientBrush>
                            </Ellipse.Stroke>
                        </Ellipse>

                        <!-- T4: Secondary inner reflection -->
                        <Ellipse Width="122" Height="122"
                                 StrokeThickness="2"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 IsHitTestVisible="False">
                            <Ellipse.Stroke>
                                <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                                    <GradientStop Color="#38FFFFFF" Offset="0.0" />
                                    <GradientStop Color="#00FFFFFF" Offset="0.5" />
                                </LinearGradientBrush>
                            </Ellipse.Stroke>
                        </Ellipse>

                        <!-- T5: Outer bright rim -->
                        <Ellipse Width="122" Height="122"
                                 StrokeThickness="1"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 IsHitTestVisible="False">
                            <Ellipse.Stroke>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#D0FFFFFF" Offset="0.0" />
                                    <GradientStop Color="#40FFFFFF" Offset="0.5" />
                                    <GradientStop Color="#20FFFFFF" Offset="1.0" />
                                </LinearGradientBrush>
                            </Ellipse.Stroke>
                        </Ellipse>

                        <!-- Layer 2: Fluid core arc (11px, gradient coral-ruby) -->
                        <Path x:Name="RingCarbsPath"
                              StrokeThickness="11"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round">
                            <Path.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FB7185" Offset="0" />
                                    <GradientStop Color="#E11D48" Offset="0.5" />
                                    <GradientStop Color="#BE123C" Offset="1" />
                                </LinearGradientBrush>
                            </Path.Stroke>
                            <Path.Effect>
                                <DropShadowEffect Color="#EF4444" BlurRadius="10" ShadowDepth="0" Opacity="0.55" />
                            </Path.Effect>
                        </Path>
                        <!-- Layer 3: Specular highlight -->
                        <Path x:Name="RingCarbsHighlightPath"
                              Stroke="#70FFFFFF"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />

                        <!-- Ring center: calories eaten / daily target -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6">
                            <TextBlock x:Name="CaloriesEatenText"
                                       Text="0 ккал"
                                       FontSize="19.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextOptions.TextFormattingMode="Display"
                                       TextOptions.TextRenderingMode="ClearType"
                                       Typography.NumeralAlignment="Tabular" />

                            <TextBlock x:Name="CaloriesTargetText"
                                       Text="з 2 100 ккал"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,1,0,0"
                                       TextOptions.TextFormattingMode="Display"
                                       TextOptions.TextRenderingMode="ClearType"
                                       Typography.NumeralAlignment="Tabular" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Row 2: Блок деталізації БЖВ під кільцями з елегантними векторними іконками -->
                <Border Grid.Row="2"
                        Background="{DynamicResource FrostedCardBgBrush}"
                        BorderBrush="{DynamicResource FrostedCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="8,8"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Колонка 1: Вуглеводи (Векторна іконка пшениці / зерна) -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Width="13" Height="13"
                                      Fill="{DynamicResource MacroCarbsBrush}"
                                      Data="M4.93,19.07L6.34,17.66L3.5,14.82L4.92,13.4L7.75,16.24L9.16,14.83L6.33,12L7.75,10.58L10.58,13.41L12,12L9.17,9.17L10.59,7.75L13.42,10.58L14.83,9.17L12,6.34L13.41,4.93L16.24,7.76L17.66,6.34L14.83,3.51L16.24,2.1L19.07,4.93L20.49,3.51L21.9,4.93L20.49,6.34L23.32,9.17L21.9,10.59L19.07,7.76L17.66,9.17L20.49,12L19.07,13.41L16.24,10.59L14.83,12L17.66,14.83L16.24,16.24L13.41,13.41L12,14.83L14.83,17.66L13.41,19.07L10.58,16.24L9.17,17.66L12,20.49L10.59,21.9L7.76,19.07L6.34,20.49L4.93,19.07M2.1,21.9L6.34,17.66L4.93,16.24L2.1,19.07V21.9H4.93Z"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,4,0" />
                                <TextBlock Text="Вуглеводи" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="CarbsEatenText"
                                       Text="0 з 235 г"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,3,0,0"
                                       Typography.NumeralAlignment="Tabular" />
                        </StackPanel>

                        <!-- Розділювач -->
                        <Border Grid.Column="1" Background="{DynamicResource SeparatorBrush}" Margin="0,2" />

                        <!-- Колонка 2: Білки (Векторна іконка шматочка м'яса / птиці) -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Width="13" Height="13"
                                      Fill="{DynamicResource MacroProteinBrush}"
                                      Data="M20.84,18.42C20.57,18.8 20.15,19 19.7,19C19.34,19 19,18.87 18.7,18.63L16.27,16.68C15.04,17.5 13.54,18 12,18C7.58,18 4,14.42 4,10C4,8.46 4.5,6.96 5.32,5.73L3.37,3.3C2.88,2.7 2.97,1.82 3.58,1.33C4.18,0.84 5.06,0.93 5.55,1.54L7.5,3.97C8.73,3.15 10.23,2.67 11.77,2.67C16.19,2.67 19.77,6.25 19.77,10.67C19.77,12.21 19.29,13.71 18.47,14.94L20.9,16.89C21.5,17.38 21.43,18.04 20.84,18.42Z"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,4,0" />
                                <TextBlock Text="Білки" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="ProteinEatenText"
                                       Text="0 з 130 г"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,3,0,0"
                                       Typography.NumeralAlignment="Tabular" />
                        </StackPanel>

                        <!-- Розділювач -->
                        <Border Grid.Column="3" Background="{DynamicResource SeparatorBrush}" Margin="0,2" />

                        <!-- Колонка 3: Жири (Векторна іконка краплі олії) -->
                        <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Width="13" Height="13"
                                      Fill="{DynamicResource MacroFatBrush}"
                                      Data="M12,2.69L17.66,8.35C19.12,9.81 20,11.8 20,14A8,8 0 0,1 12,22A8,8 0 0,1 4,14C4,11.8 4.88,9.81 6.34,8.35L12,2.69Z"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,4,0" />
                                <TextBlock Text="Жири" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="FatEatenText"
                                       Text="0 з 70 г"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,3,0,0"
                                       Typography.NumeralAlignment="Tabular" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Row 3: Розумний графік прийомів їжі (Meal Schedule & Countdown) -->
                <Border x:Name="MealScheduleCard"
                        Grid.Row="3"
                        Background="{DynamicResource FrostedCardBgBrush}"
                        BorderBrush="{DynamicResource FrostedCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="8,6"
                        Margin="0,0,0,8"
                        Cursor="Hand"
                        MouseLeftButtonUp="MealScheduleCard_Click"
                        ToolTip="Натисніть, щоб розгорнути або згорнути графік прийомів їжі на сьогодні">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Іконка статусу -->
                            <Border x:Name="MealIconBadge"
                                    Grid.Column="0"
                                    Width="26"
                                    Height="26"
                                    CornerRadius="6"
                                    Background="{DynamicResource InputBgBrush}"
                                    Margin="0,0,7,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="MealIconEmoji"
                                           Text="🕒"
                                           FontSize="13"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <!-- Текст статусу та ціль -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="NextMealHeadline"
                                           Text="🕒 Наступний: Сніданок о 09:00"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="NextMealTarget"
                                           Text="Ціль: ~520 ккал | 32г Б · 17г Ж · 58г В"
                                           FontSize="9"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,1,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Стрілка розгортання -->
                            <Path x:Name="MealTimelineArrow"
                                  Grid.Column="2"
                                  Width="8"
                                  Height="8"
                                  Fill="{DynamicResource TextMutedBrush}"
                                  Data="M7,10L12,15L17,10H7Z"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="4,0,2,0" />
                        </Grid>

                        <!-- Розгорнутий міні-таймлайн (динамічно наповнюється в коді) -->
                        <StackPanel x:Name="MealTimelinePanel" Visibility="Collapsed" Margin="0,6,0,2">
                            <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,0,0,5" />
                            <StackPanel x:Name="MealTimelineItemsContainer" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Row 4: КНОПКА ДОДАВАННЯ: + Додати продукт чи напій... -->
                <Border Grid.Row="4"
                        Background="{DynamicResource FrostedCardBgBrush}"
                        BorderBrush="{DynamicResource FrostedCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="0"
                        Height="40">
                    <Button x:Name="OpenCatalogBtn"
                            Style="{StaticResource MinimalTextButton}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="12,8"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Click="OpenCatalog_Click"
                            ToolTip="Відкрити бічну панель каталогу продуктів">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="+" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource MacroEmeraldBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Додати продукт чи напій..." FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>

            <!-- ============================================================== -->
            <!-- КОЛОНКА 1: БІЧНИЙ ВИСУВНИЙ КАТАЛОГ (FLYOUT DRAWER)            -->
            <!-- ============================================================== -->
            <Border x:Name="FlyoutDrawer"
                    Grid.Column="1"
                    BorderThickness="1,0,0,0"
                    BorderBrush="{DynamicResource WindowGlassBorderBrush}"
                    Background="Transparent"
                    CornerRadius="0,20,20,0"
                    Padding="14,10,14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />  <!-- 0: Header & Close Button -->
                        <RowDefinition Height="Auto" />  <!-- 1: Search Box & Category Pills -->
                        <RowDefinition Height="*" />     <!-- 2: Scrollable Products List -->
                        <RowDefinition Height="Auto" />  <!-- 3: Bottom Portion Selector & Add Button -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Шапка каталогу -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="КАТАЛОГ ПРОДУКТІВ"
                                       FontSize="9.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="Оберіть страву або напій"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,1,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Style="{StaticResource MinimalIconButton}"
                                Click="CloseCatalog_Click"
                                Padding="5"
                                ToolTip="Згорнути каталог">
                            <Path Width="11" Height="11"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                  Stretch="Uniform" />
                        </Button>
                    </Grid>

                    <!-- Row 1: Швидкий пошук та горизонтальні чіпси категорій -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <!-- Поле швидкого пошуку -->
                        <Border Background="{DynamicResource FrostedCardBgBrush}"
                                BorderBrush="{DynamicResource FrostedCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="8,5"
                                Margin="0,0,0,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Іконка пошуку (лупа) -->
                                <Path Width="11" Height="11"
                                      Fill="{DynamicResource TextMutedBrush}"
                                      Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0" />

                                <TextBlock x:Name="FlyoutSearchPlaceholder"
                                           Grid.Column="1"
                                           Text="Пошук продукту..."
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Opacity="0.65"
                                           FontSize="11.5"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False" />

                                <TextBox x:Name="FlyoutSearchBox"
                                         Grid.Column="1"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                                         FontSize="11.5"
                                         TextChanged="FlyoutSearchBox_TextChanged" />
                            </Grid>
                        </Border>

                        <!-- Чіпси-категорії (горизонтальний скрол) -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,1">
                                <RadioButton x:Name="CatAllRadio" Content="Всі" GroupName="FlyoutCat" IsChecked="True" Checked="FlyoutCategoryRadio_Checked" Style="{StaticResource FlyoutCategoryPill}" />
                                <RadioButton x:Name="CatMeatRadio" Content="🥩 М'ясо" GroupName="FlyoutCat" Checked="FlyoutCategoryRadio_Checked" Style="{StaticResource FlyoutCategoryPill}" />
                                <RadioButton x:Name="CatDairyRadio" Content="🥛 Молочне" GroupName="FlyoutCat" Checked="FlyoutCategoryRadio_Checked" Style="{StaticResource FlyoutCategoryPill}" />
                                <RadioButton x:Name="CatDrinksRadio" Content="🥤 Напої" GroupName="FlyoutCat" Checked="FlyoutCategoryRadio_Checked" Style="{StaticResource FlyoutCategoryPill}" />
                                <RadioButton x:Name="CatBakeryRadio" Content="🍞 Хліб та соуси" GroupName="FlyoutCat" Checked="FlyoutCategoryRadio_Checked" Style="{StaticResource FlyoutCategoryPill}" />
                                <RadioButton x:Name="CatGrainsRadio" Content="🍚 Гарніри та овочі" GroupName="FlyoutCat" Checked="FlyoutCategoryRadio_Checked" Style="{StaticResource FlyoutCategoryPill}" />
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Row 2: Список карток продуктів (Tile Cards) -->
                    <Border Grid.Row="2" Background="Transparent" BorderThickness="0">
                        <ListBox x:Name="FlyoutFoodListBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 SelectionChanged="FlyoutFoodListBox_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="{DynamicResource FrostedCardBgBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource FrostedCardBorderBrush}" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                    <Setter Property="Padding" Value="9,6" />
                                    <Setter Property="Margin" Value="0,2" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="cardBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}"
                                                        Margin="{TemplateBinding Margin}"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="cardBorder" Property="Background" Value="{DynamicResource HoverBgBrush}" />
                                                        <Setter TargetName="cardBorder" Property="BorderBrush" Value="{DynamicResource InputFocusBorderBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="cardBorder" Property="Background" Value="{DynamicResource HoverBgBrush}" />
                                                        <Setter TargetName="cardBorder" Property="BorderBrush" Value="{DynamicResource MacroEmeraldBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Аватарка/іконка категорії (38x38 px) з пастельним фоном залежно від теми -->
                                        <Border Grid.Column="0"
                                                Width="38"
                                                Height="38"
                                                CornerRadius="8"
                                                Background="{DynamicResource ProductAvatarBgBrush}"
                                                BorderBrush="{DynamicResource ProductAvatarBorderBrush}"
                                                BorderThickness="1"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding IconEmoji, Mode=OneWay}"
                                                       FontSize="18"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Назва та БЖВ-бейджики -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <Border Background="{DynamicResource MacroProteinTrackBrush}" BorderBrush="{DynamicResource MacroProteinBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,4,0">
                                                    <TextBlock Text="{Binding ProteinBadgeText, Mode=OneWay}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource MacroProteinBrush}" />
                                                </Border>
                                                <Border Background="{DynamicResource MacroFatTrackBrush}" BorderBrush="{DynamicResource MacroFatBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,4,0">
                                                    <TextBlock Text="{Binding FatBadgeText, Mode=OneWay}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource MacroFatBrush}" />
                                                </Border>
                                                <Border Background="{DynamicResource MacroCarbsTrackBrush}" BorderBrush="{DynamicResource MacroCarbsBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1">
                                                    <TextBlock Text="{Binding CarbsBadgeText, Mode=OneWay}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource MacroCarbsBrush}" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Калорійність праворуч -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="6,0,2,0">
                                            <TextBlock Text="{Binding CaloriesFormatted, Mode=OneWay}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Right"
                                                       Typography.NumeralAlignment="Tabular" />
                                            <TextBlock Text="{Binding UnitPer100Text, Mode=OneWay}"
                                                       FontSize="9.5"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- Row 3: Нижня панель вибору порції (інтерактивна) -->
                    <Border Grid.Row="3"
                            Background="{DynamicResource FrostedCardBgBrush}"
                            BorderBrush="{DynamicResource FrostedCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Швидкі кнопки вибору порції -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="FlyoutPortionLabel"
                                           Text="Порція:"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0" />

                                <!-- Кнопки напоїв -->
                                <StackPanel x:Name="FlyoutDrinkPresets" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                    <Button Content="250 мл" Style="{StaticResource FlyoutPortionChip}" Click="FlyoutPortionChip_Click" Tag="250" />
                                    <Button Content="330 мл" Style="{StaticResource FlyoutPortionChip}" Click="FlyoutPortionChip_Click" Tag="330" />
                                    <Button Content="500 мл" Style="{StaticResource FlyoutPortionChip}" Click="FlyoutPortionChip_Click" Tag="500" />
                                    <Button Content="1 л" Style="{StaticResource FlyoutPortionChip}" Click="FlyoutPortionChip_Click" Tag="1000" />
                                </StackPanel>

                                <!-- Кнопки їжі -->
                                <StackPanel x:Name="FlyoutFoodPresets" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="50 г" Style="{StaticResource FlyoutPortionChip}" Click="FlyoutPortionChip_Click" Tag="50" />
                                    <Button Content="100 г" Style="{StaticResource FlyoutPortionChip}" Click="FlyoutPortionChip_Click" Tag="100" />
                                    <Button Content="150 г" Style="{StaticResource FlyoutPortionChip}" Click="FlyoutPortionChip_Click" Tag="150" />
                                    <Button Content="200 г" Style="{StaticResource FlyoutPortionChip}" Click="FlyoutPortionChip_Click" Tag="200" />
                                </StackPanel>

                                <!-- Ручне введення ваги/об'єму -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource FrostedCardBgBrush}"
                                            BorderBrush="{DynamicResource FrostedCardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="4,2">
                                        <TextBox x:Name="FlyoutPortionBox"
                                                 Text="150"
                                                 Width="42"
                                                 TextAlignment="Center"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 FontSize="11.5"
                                                 FontWeight="SemiBold"
                                                 TextChanged="FlyoutPortionBox_TextChanged" />
                                    </Border>
                                    <TextBlock x:Name="FlyoutPortionUnitText"
                                               Text="г"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <Separator Grid.Row="1" Background="{DynamicResource SeparatorBrush}" Margin="0,6" />

                            <!-- Підсумок розрахунку та кнопка дії -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="FlyoutLiveSummary"
                                           Text="У цій порції: 0 ккал"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,6,0"
                                           Typography.NumeralAlignment="Tabular" />

                                <Button x:Name="FlyoutAddFoodBtn"
                                        Grid.Column="1"
                                        Content="✓ Додати"
                                        Style="{StaticResource MinimalTextButton}"
                                        Background="{DynamicResource MacroEmeraldBrush}"
                                        Foreground="#FFFFFF"
                                        BorderThickness="0"
                                        FontWeight="SemiBold"
                                        FontSize="11.5"
                                        Padding="14,6"
                                        Height="30"
                                        Click="FlyoutAddFood_Click" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Border>
</Window>
