<Window x:Class="CalWidget.AddFoodDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Каталог продуктів та напоїв"
        Width="580"
        Height="670"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <!-- Елегантний стиль перемикача категорій (Pill Tab) -->
        <Style x:Key="CategoryPillRadio" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="pillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,6,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="{DynamicResource HoverBgBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="{DynamicResource HoverBgBrush}" />
                                <Setter TargetName="pillBorder" Property="BorderBrush" Value="{DynamicResource MacroEmeraldBrush}" />
                                <Setter TargetName="pillBorder" Property="BorderThickness" Value="1.5" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для швидких чіпсів вибору порції -->
        <Style x:Key="PortionChipButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chipBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,5,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chipBorder" Property="Background" Value="{DynamicResource HoverBgBrush}" />
                                <Setter TargetName="chipBorder" Property="BorderBrush" Value="{DynamicResource MacroEmeraldBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="chipBorder" Property="Background" Value="{DynamicResource MacroEmeraldBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BgSurfaceBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" Color="#000000" Opacity="0.4" ShadowDepth="8" />
        </Border.Effect>

        <Grid Margin="18,16,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- 0: Header -->
                <RowDefinition Height="Auto" />  <!-- 1: Search & Category Pills -->
                <RowDefinition Height="*" />     <!-- 2: Tile Cards Grid or Custom Form -->
                <RowDefinition Height="Auto" />  <!-- 3: Portion Selector & Live Summary -->
                <RowDefinition Height="Auto" />  <!-- 4: Bottom Actions -->
            </Grid.RowDefinitions>

            <!-- Row 0: Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="КАТАЛОГ ПРОДУКТІВ ТА НАПОЇВ"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="Оберіть продукт або додайте власну страву"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource MinimalIconButton}"
                        Click="CloseButton_Click"
                        Padding="5"
                        ToolTip="Закрити">
                    <Path Width="11" Height="11"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                          Stretch="Uniform" />
                </Button>
            </Grid>

            <!-- Row 1: Search & Category Pills -->
            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <!-- Search Box -->
                <Border Background="{DynamicResource InputBgBrush}"
                        BorderBrush="{DynamicResource InputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,6"
                        Margin="0,0,0,10">
                    <Grid>
                        <TextBlock x:Name="SearchPlaceholder"
                                   Text="Пошук страви чи напою (напр. філе, кола, гречка, сир)..."
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Opacity="0.65"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                        <TextBox x:Name="SearchBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                                 FontSize="12"
                                 TextChanged="SearchBox_TextChanged" />
                    </Grid>
                </Border>

                <!-- Category Pills (Horizontal Scroll) -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <RadioButton x:Name="CatAllRadio" Content="Всі продукти" GroupName="FoodCategory" IsChecked="True" Checked="CategoryRadio_Checked" Style="{StaticResource CategoryPillRadio}" />
                        <RadioButton x:Name="CatMeatRadio" Content="🥩 М'ясо та птиця" GroupName="FoodCategory" Checked="CategoryRadio_Checked" Style="{StaticResource CategoryPillRadio}" />
                        <RadioButton x:Name="CatDairyRadio" Content="🥛 Молочне" GroupName="FoodCategory" Checked="CategoryRadio_Checked" Style="{StaticResource CategoryPillRadio}" />
                        <RadioButton x:Name="CatDrinksRadio" Content="🥤 Напої" GroupName="FoodCategory" Checked="CategoryRadio_Checked" Style="{StaticResource CategoryPillRadio}" />
                        <RadioButton x:Name="CatGrainsRadio" Content="🍚 Гарніри та крупи" GroupName="FoodCategory" Checked="CategoryRadio_Checked" Style="{StaticResource CategoryPillRadio}" />
                        <RadioButton x:Name="CatCustomRadio" Content="+ Свій продукт" GroupName="FoodCategory" Checked="CategoryRadio_Checked" Style="{StaticResource CategoryPillRadio}" Foreground="{DynamicResource MacroEmeraldBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>

            <!-- Row 2: Main Area (Tile Cards List or Custom Form) -->
            <Grid Grid.Row="2">
                <!-- Food Cards List -->
                <Border x:Name="CatalogListContainer"
                        Background="Transparent"
                        BorderThickness="0">
                    <ListBox x:Name="FoodListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="FoodListBox_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                                <Setter Property="BorderThickness" Value="1.5" />
                                <Setter Property="Padding" Value="12,9" />
                                <Setter Property="Margin" Value="0,3" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="itemCardBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="10"
                                                    Padding="{TemplateBinding Padding}"
                                                    Margin="{TemplateBinding Margin}"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="itemCardBorder" Property="Background" Value="{DynamicResource HoverBgBrush}" />
                                                    <Setter TargetName="itemCardBorder" Property="BorderBrush" Value="{DynamicResource InputFocusBorderBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="itemCardBorder" Property="Background" Value="{DynamicResource HoverBgBrush}" />
                                                    <Setter TargetName="itemCardBorder" Property="BorderBrush" Value="{DynamicResource MacroEmeraldBrush}" />
                                                    <Setter TargetName="itemCardBorder" Property="BorderThickness" Value="1.5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />  <!-- 0: Avatar 44x44 -->
                                        <ColumnDefinition Width="*" />     <!-- 1: Name & Macro Capsules -->
                                        <ColumnDefinition Width="Auto" />  <!-- 2: Calories per 100g/ml -->
                                    </Grid.ColumnDefinitions>

                                    <!-- 0: Іконка-аватар (44x44 px) із заокругленим кольоровим фоном -->
                                    <Border Grid.Column="0"
                                            Width="44"
                                            Height="44"
                                            CornerRadius="10"
                                            Background="{Binding IconBgBrushHex, Mode=OneWay}"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IconEmoji, Mode=OneWay}"
                                                   FontSize="22"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <!-- 1: Назва та кольорові БЖВ-мікрокапсули -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />

                                        <!-- Компактні кольорові капсули БЖВ -->
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <!-- Білки (Синя капсула) -->
                                            <Border Background="{DynamicResource MacroProteinTrackBrush}"
                                                    BorderBrush="{DynamicResource MacroProteinBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="6,2"
                                                    Margin="0,0,6,0">
                                                <TextBlock Text="{Binding ProteinBadgeText, Mode=OneWay}"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource MacroProteinBrush}" />
                                            </Border>

                                            <!-- Жири (Помаранчева капсула) -->
                                            <Border Background="{DynamicResource MacroFatTrackBrush}"
                                                    BorderBrush="{DynamicResource MacroFatBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="6,2"
                                                    Margin="0,0,6,0">
                                                <TextBlock Text="{Binding FatBadgeText, Mode=OneWay}"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource MacroFatBrush}" />
                                            </Border>

                                            <!-- Вуглеводи (Червона/коралова капсула) -->
                                            <Border Background="{DynamicResource MacroCarbsTrackBrush}"
                                                    BorderBrush="{DynamicResource MacroCarbsBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="6,2">
                                                <TextBlock Text="{Binding CarbsBadgeText, Mode=OneWay}"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource MacroCarbsBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 2: Калорійність справа (велика цифра + підпис) -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,4,0">
                                        <TextBlock Text="{Binding CaloriesFormatted, Mode=OneWay}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Right"
                                                   Typography.NumeralAlignment="Tabular" />
                                        <TextBlock Text="{Binding UnitPer100Text, Mode=OneWay}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Custom Product Form (shown when CatCustomRadio is selected) -->
                <Border x:Name="CustomFormContainer"
                        Background="{DynamicResource CardSurfaceBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16,14"
                        Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Назва власної страви:" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                            <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,12">
                                <TextBox x:Name="CustomNameBox" Text="Домашня вечеря" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" />
                            </Border>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Калорії (ккал):" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                                    <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                        <TextBox x:Name="CustomCalBox" Text="450" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Вага або об'єм (г/мл):" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                                    <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                        <TextBox x:Name="CustomPortionBox" Text="200" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Білки (г):" FontSize="11" Foreground="{DynamicResource MacroProteinBrush}" Margin="0,0,0,4" />
                                    <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,6">
                                        <TextBox x:Name="CustomProteinBox" Text="25" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Жири (г):" FontSize="11" Foreground="{DynamicResource MacroFatBrush}" Margin="0,0,0,4" />
                                    <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,6">
                                        <TextBox x:Name="CustomFatBox" Text="15" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Вуглеводи (г):" FontSize="11" Foreground="{DynamicResource MacroCarbsBrush}" Margin="0,0,0,4" />
                                    <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,6">
                                        <TextBox x:Name="CustomCarbsBox" Text="45" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <CheckBox x:Name="SaveToCatalogCheck" Content="Зберегти цей продукт у каталог для швидкого доступу" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" IsChecked="True" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Row 3: Portion Selector & Live Summary -->
            <Border x:Name="PortionSection"
                    Grid.Row="3"
                    Background="{DynamicResource CardSurfaceBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,10"
                    Margin="0,10,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />  <!-- Presets & Manual Input -->
                        <RowDefinition Height="Auto" />  <!-- Separator -->
                        <RowDefinition Height="Auto" />  <!-- Live Summary -->
                    </Grid.RowDefinitions>

                    <!-- Presets & Manual Amount -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="PortionLabel"
                                   Text="Порція:"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />

                        <!-- Швидкі чіпси для напоїв (мл / л) -->
                        <StackPanel x:Name="DrinkPresetsPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                            <Button Content="250 мл 🥛" Style="{StaticResource PortionChipButton}" Click="SetPortion_Click" Tag="250" />
                            <Button Content="330 мл 🥫" Style="{StaticResource PortionChipButton}" Click="SetPortion_Click" Tag="330" />
                            <Button Content="500 мл 🍶" Style="{StaticResource PortionChipButton}" Click="SetPortion_Click" Tag="500" />
                            <Button Content="1.0 л 🍾" Style="{StaticResource PortionChipButton}" Click="SetPortion_Click" Tag="1000" />
                        </StackPanel>

                        <!-- Швидкі чіпси для їжі (г) -->
                        <StackPanel x:Name="FoodPresetsPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="50 г" Style="{StaticResource PortionChipButton}" Click="SetPortion_Click" Tag="50" />
                            <Button Content="100 г" Style="{StaticResource PortionChipButton}" Click="SetPortion_Click" Tag="100" />
                            <Button Content="150 г" Style="{StaticResource PortionChipButton}" Click="SetPortion_Click" Tag="150" />
                            <Button Content="200 г" Style="{StaticResource PortionChipButton}" Click="SetPortion_Click" Tag="200" />
                            <Button Content="300 г" Style="{StaticResource PortionChipButton}" Click="SetPortion_Click" Tag="300" />
                        </StackPanel>

                        <!-- Поле ручного введення з одиницею -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource InputBgBrush}"
                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="6,3">
                                <TextBox x:Name="PortionAmountBox"
                                         Text="150"
                                         Width="48"
                                         TextAlignment="Center"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                                         FontSize="12.5"
                                         FontWeight="SemiBold"
                                         TextChanged="PortionAmountBox_TextChanged" />
                            </Border>
                            <TextBlock x:Name="PortionUnitText"
                                       Text="г"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <Separator Grid.Row="1" Background="{DynamicResource SeparatorBrush}" Margin="0,8" />

                    <!-- Live Summary: Великий підсумок порції -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Живий підсумок одним рядком: "У цій порції: 210 ккал | Б: 0г | Ж: 0г | В: 53г" -->
                        <TextBlock x:Name="LiveSummaryText"
                                   Text="У цій порції: 0 ккал | Б: 0г | Ж: 0г | В: 0г"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular" />

                        <!-- Деталізація калорій великим бейджем -->
                        <Border Grid.Column="1"
                                Background="{DynamicResource HoverBgBrush}"
                                CornerRadius="6"
                                Padding="8,3">
                            <TextBlock x:Name="PreviewCalories"
                                       Text="0 ккал"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Typography.NumeralAlignment="Tabular" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Row 4: Bottom Actions -->
            <Grid Grid.Row="4" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="SelectedFoodTitle"
                           Text="Оберіть продукт зі списку"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,10,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Скасувати"
                            Style="{StaticResource MinimalTextButton}"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Click="CloseButton_Click"
                            Margin="0,0,8,0"
                            Padding="12,7"
                            FontSize="12" />

                    <Button x:Name="AddFoodBtn"
                            Content="✓ Додати у віджет"
                            Style="{StaticResource MinimalTextButton}"
                            Background="{DynamicResource MacroEmeraldBrush}"
                            Foreground="#FFFFFF"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            FontSize="12.5"
                            Padding="16,8"
                            Height="36"
                            Click="AddFoodButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
